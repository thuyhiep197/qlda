# Sao chép file này thành .env rồi chỉnh sửa

# Tên miền truy cập tool (đã trỏ DNS bản ghi A về IP public của server)
DOMAIN=qlda.tencongty.vn

# Tài khoản quản trị tạo ở lần chạy đầu tiên (bắt buộc đổi mật khẩu khi đăng nhập)
ADMIN_USERNAME=admin
ADMIN_FULLNAME=Quản trị hệ thống
ADMIN_PASSWORD=Admin@123

# Cổng web
PORT=3001

# Chỉ dùng khi chạy local không qua HTTPS. Trên server, docker-compose luôn đặt COOKIE_SECURE=true
COOKIE_SECURE=false

# Dung lượng tối đa mỗi tệp đính kèm (MB)
MAX_UPLOAD_MB=25

# Số bản sao lưu CSDL tự động (mỗi ngày 1 bản) được giữ lại; 0 = tắt
BACKUP_KEEP=14

# Chống dò mật khẩu: mặc định BẬT (khóa 15 phút khi sai 5 lần). Chỉ tắt khi thật cần:
# LOGIN_LOCKOUT=off

TZ=Asia/Ho_Chi_Minh
